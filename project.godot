config_version=5

[application]

config/name="Ceno0 Inspired Fighting Game (4.4)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://scripts/signal_bus.gd"
ControllerManager="*res://scripts/controller_manager.gd"
Global="*res://scripts/global.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
StageManager="*res://scripts/stage_manager.gd"
CameraManager="*res://scripts/camera_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

